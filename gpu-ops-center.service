[Unit]
Description=GPU Ops Center - GPU cluster management console (Node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际部署路径与 Node 位置修改
WorkingDirectory=/opt/gpu-ops-center
ExecStart=/usr/bin/node /opt/gpu-ops-center/server/api.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
